GraniteCave_StevensRoom_MapScripts::
	map_script MAP_SCRIPT_ON_TRANSITION, GraniteCave_StevensRoom_OnTransition	@ open hoenn
	.byte 0

GraniteCave_StevensRoom_OnTransition:	@ open hoenn
	call GraniteCave_StevensRoom_EventScript_OpenHoennStevenSetup	@ open hoenn
	end	@ open hoenn










GraniteCave_StevensRoom_EventScript_Steven::
	lock
	faceplayer
	msgbox GraniteCave_StevensRoom_Text_ImStevenLetterForMe, MSGBOX_DEFAULT
	setvar VAR_0x8004, ITEM_LETTER
	call Common_EventScript_PlayerHandedOverTheItem
	setflag FLAG_DELIVERED_STEVEN_LETTER
	msgbox GraniteCave_StevensRoom_Text_ThankYouTakeThis, MSGBOX_DEFAULT
	giveitem ITEM_TM_STEEL_WING
	call_if_eq VAR_RESULT, FALSE, GraniteCave_StevensRoom_EventScript_BagFull
	msgbox GraniteCave_StevensRoom_Text_CouldBecomeChampionLetsRegister, MSGBOX_DEFAULT
	closemessage
	delay 30
	playfanfare MUS_REGISTER_MATCH_CALL
	msgbox GraniteCave_StevensRoom_Text_RegisteredSteven, MSGBOX_DEFAULT
	waitfanfare
	closemessage
	delay 30
	setflag FLAG_REGISTERED_STEVEN_POKENAV
	msgbox GraniteCave_StevensRoom_Text_IveGotToHurryAlong, MSGBOX_DEFAULT
	closemessage
	call_if_eq VAR_FACING, DIR_NORTH, GraniteCave_StevensRoom_EventScript_StevenExitNorth
	call_if_eq VAR_FACING, DIR_SOUTH, GraniteCave_StevensRoom_EventScript_StevenExitSouth
	call_if_eq VAR_FACING, DIR_WEST, GraniteCave_StevensRoom_EventScript_StevenExitWestEast
	call_if_eq VAR_FACING, DIR_EAST, GraniteCave_StevensRoom_EventScript_StevenExitWestEast
	playse SE_EXIT
	removeobject LOCALID_GRANITE_CAVE_STEVEN
	release
	end

GraniteCave_StevensRoom_EventScript_StevenExitNorth::
	applymovement LOCALID_GRANITE_CAVE_STEVEN, GraniteCave_StevensRoom_Movement_StevenExit
	waitmovement 0
	return

GraniteCave_StevensRoom_EventScript_StevenExitWestEast::
	applymovement LOCALID_PLAYER, GraniteCave_StevensRoom_Movement_PlayerTurnTowardExit
	applymovement LOCALID_GRANITE_CAVE_STEVEN, GraniteCave_StevensRoom_Movement_StevenExit
	waitmovement 0
	return

GraniteCave_StevensRoom_EventScript_StevenExitSouth::
	applymovement LOCALID_PLAYER, GraniteCave_StevensRoom_Movement_PlayerTurnTowardExit
	applymovement LOCALID_GRANITE_CAVE_STEVEN, GraniteCave_StevensRoom_Movement_StevenExitSouth
	waitmovement 0
	return

GraniteCave_StevensRoom_EventScript_BagFull::
	msgbox GraniteCave_StevensRoom_Text_OhBagIsFull, MSGBOX_DEFAULT
	return

GraniteCave_StevensRoom_Movement_StevenExit:
	walk_up
	walk_up
	walk_up
	walk_up
	walk_up
	delay_8
	step_end

GraniteCave_StevensRoom_Movement_PlayerTurnTowardExit:
	delay_16
	delay_16
	delay_16
	walk_in_place_faster_up
	step_end

GraniteCave_StevensRoom_Movement_StevenExitSouth:
	walk_left
	walk_up
	walk_up
	walk_up
	walk_right
	walk_up
	walk_up
	delay_8
	step_end

GraniteCave_StevensRoom_Text_ImStevenLetterForMe:
	.string "My name is STEVEN.\p"
	.string "I'm interested in rare stones,\n"
	.string "so I travel here and there.\p"
	.string "Oh?\n"
	.string "A LETTER for me?$"

GraniteCave_StevensRoom_Text_ThankYouTakeThis:
	.string "STEVEN: Okay, thank you.\p"
	.string "You went through all this trouble to\n"
	.string "deliver that. I need to thank you.\p"
	.string "Let me see…\n"
	.string "I'll give you this TM.\p"
	.string "It contains my favorite move,\n"
	.string "STEEL WING.$"

GraniteCave_StevensRoom_Text_CouldBecomeChampionLetsRegister:
	.string "STEVEN: Your POKéMON appear quite\n"
	.string "capable.\p"
	.string "If you keep training, you could even\n"
	.string "become the CHAMPION of the POKéMON\l"
	.string "LEAGUE one day. That's what I think.\p"
	.string "I know, since we've gotten to know each\n"
	.string "other, let's register one another in\l"
	.string "our POKéNAVS.\p"
	.string "… … … … … …$"

GraniteCave_StevensRoom_Text_RegisteredSteven:
	.string "Registered STEVEN\n"
	.string "in the POKéNAV.$"

GraniteCave_StevensRoom_Text_IveGotToHurryAlong:
	.string "Now, I've got to hurry along.$"

GraniteCave_StevensRoom_Text_OhBagIsFull:
	.string "Oh, your BAG is full…\n"
	.string "That's too bad, then.$"

@ --- open hoenn: trades generated by tools/trades.py ---

GraniteCave_StevensRoom_EventScript_OpenHoennStevenSetup::
	goto_if_set FLAG_DELIVERED_STEVEN_LETTER, GraniteCave_StevensRoom_EventScript_OpenHoennStevenSwap
	clearflag FLAG_HIDE_GRANITE_CAVE_STEVEN
	setflag FLAG_HIDE_GRANITE_CAVE_TRADER_STEVEN
	return

GraniteCave_StevensRoom_EventScript_OpenHoennStevenSwap::
	setflag FLAG_HIDE_GRANITE_CAVE_STEVEN
	clearflag FLAG_HIDE_GRANITE_CAVE_TRADER_STEVEN
	return

GraniteCave_StevensRoom_EventScript_OreSteven::
	lock
	faceplayer
	checkitem ITEM_LIQUID_ORE, 1
	goto_if_eq VAR_RESULT, FALSE, GraniteCave_StevensRoom_EventScript_StevenNoOre
	msgbox GraniteCave_StevensRoom_Text_StevenOffer, MSGBOX_YESNO
	goto_if_eq VAR_RESULT, NO, GraniteCave_StevensRoom_EventScript_StevenDecline
	getpartysize
	goto_if_eq VAR_RESULT, PARTY_SIZE, GraniteCave_StevensRoom_EventScript_StevenPartyFull
	removeitem ITEM_LIQUID_ORE, 1
	givemon SPECIES_METAL_SLIME, 1, ITEM_NONE
	playfanfare MUS_OBTAIN_ITEM
	waitfanfare
	msgbox GraniteCave_StevensRoom_Text_StevenAfter, MSGBOX_DEFAULT
	release
	end

GraniteCave_StevensRoom_EventScript_StevenNoOre::
	msgbox GraniteCave_StevensRoom_Text_StevenNoOre, MSGBOX_DEFAULT
	release
	end

GraniteCave_StevensRoom_EventScript_StevenDecline::
	msgbox GraniteCave_StevensRoom_Text_StevenDecline, MSGBOX_DEFAULT
	release
	end

GraniteCave_StevensRoom_EventScript_StevenPartyFull::
	msgbox GraniteCave_StevensRoom_Text_StevenPartyFull, MSGBOX_DEFAULT
	release
	end

GraniteCave_StevensRoom_Text_StevenOffer:
	.string "That ore in your bag - may I see it?\p"
	.string "Extraordinary. It has a shine no\n"
	.string "mineral of this region should have,\l"
	.string "and it is warm, which stone is not.\p"
	.string "I would very much like it. In return,\n"
	.string "a POKéMON I found in the same seam.\p"
	.string "Would you trade?$"

GraniteCave_StevensRoom_Text_StevenAfter:
	.string "Take good care of it. It is young.\p"
	.string "Curious, is it not, that the ore and\n"
	.string "the POKéMON weigh exactly the same?\p"
	.string "I have been trying not to think\n"
	.string "about that.$"

GraniteCave_StevensRoom_Text_StevenNoOre:
	.string "I came back down for the rock, not\n"
	.string "for the quiet.\p"
	.string "There is an ore in the far corners\n"
	.string "of the newer routes - heavy, bright,\l"
	.string "and it will not sit still.\p"
	.string "Bring me one and I will make it\n"
	.string "worth the walk.$"

GraniteCave_StevensRoom_Text_StevenDecline:
	.string "Of course. Think it over.$"

GraniteCave_StevensRoom_Text_StevenPartyFull:
	.string "Your team is full. I would rather it\n"
	.string "went straight into your care.$"

@ --- end open hoenn trades ---
