	lock
	faceplayer
	waitse
	playmoncry SPECIES_NINETALES_A, CRY_MODE_ENCOUNTER
	delay 40
	waitmoncry
	setwildbattle SPECIES_NINETALES_A, 40
	dowildbattle
	specialvar VAR_RESULT, GetBattleOutcome
	goto_if_eq VAR_RESULT, B_OUTCOME_WON, ShoalCave_LowTideLowerRoom_EventScript_StaticNinetalesAGone
	goto_if_eq VAR_RESULT, B_OUTCOME_CAUGHT, ShoalCave_LowTideLowerRoom_EventScript_StaticNinetalesAGone
	goto_if_eq VAR_RESULT, B_OUTCOME_RAN, ShoalCave_LowTideLowerRoom_EventScript_StaticNinetalesAFled
	goto_if_eq VAR_RESULT, B_OUTCOME_PLAYER_TELEPORTED, ShoalCave_LowTideLowerRoom_EventScript_StaticNinetalesAFled
	setflag FLAG_CAUGHT_STATIC_NINETALES_A
	release
	end

